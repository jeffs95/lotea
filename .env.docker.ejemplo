# Lo que hay que llenar para levantar Lotea en un servidor propio.
#
# Se copia como .env junto al docker-compose.yml. En Coolify no se usa este
# archivo: las mismas variables se escriben en el panel del proyecto.
#
# Nunca se sube al repositorio. El repositorio es público.

# ------------------------------------------------------------- la aplicación
APP_NAME=Lotea
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.lotea.dev

# Se genera una vez con: php artisan key:generate --show
# Si se cambia después, las sesiones y lo cifrado dejan de poder leerse.
APP_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_GT

# -------------------------------------------------------------------- la base
# «base» es el nombre del servicio en docker-compose.yml, y dentro de la red
# de Docker eso funciona como nombre de servidor.
DB_CONNECTION=pgsql
DB_HOST=base
DB_PORT=5432
DB_DATABASE=lotea
DB_USERNAME=lotea
DB_PASSWORD=

# ------------------------------------------------------- sesiones y procesos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Vacío a propósito: cada concesionario entra por su propio dominio, y fijar
# uno dejaría a los demás sin poder iniciar sesión.
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

# El contenedor «worker» del compose es el que los atiende. Si se apaga, las
# fotos nuevas se quedan sin las versiones que ve el portal.
MEDIA_CONVERSIONES_EN_COLA=true

# ----------------------------------------------- los archivos, en Cloudflare
# Las fotos y los documentos NO viven en el servidor: están en R2. Por eso un
# servidor chico alcanza, y por eso mudarse de servidor no mueve archivos.
FILESYSTEM_DISK=r2_publico
LOTEA_DISCO_ARCHIVOS=r2_publico
LOTEA_DISCO_PUBLICO=r2_publico

# El de los documentos y las fotos de DPI. Si se deja vacío, los dos cubos
# pasan a ser el mismo y los documentos de identidad terminan donde no deben.
LOTEA_DISCO_PRIVADO=r2_privado

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLICO=lotea-publico
R2_BUCKET_PRIVADO=lotea-privado
R2_URL_PUBLICA=https://archivos.lotea.dev

# ------------------------------------------------------------- correo saliente
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------- lectura de documentos con IA (opcional)
# Sin esto el sistema funciona; solo deja de ofrecerse el botón de leer el
# título con IA. El plan de cada cliente decide si lo tiene.
OPENROUTER_API_KEY=
OPENROUTER_MODELO=
OPENROUTER_PRECIO_ENTRADA=
OPENROUTER_PRECIO_SALIDA=

# ---------------------------------------- el primer usuario, solo al instalar
# Lo usa el seeder del operador la primera vez. Después conviene borrarlas.
LOTEA_OPERADOR_NAME=
LOTEA_OPERADOR_EMAIL=
LOTEA_OPERADOR_PASSWORD=

# ------------------------------------------------- solo para docker compose
# El puerto del servidor por el que entra el tráfico al contenedor.
LOTEA_PUERTO=8080
