<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            El decodificador de códigos QR arma la matriz entera en memoria, y
            con los 128 MB de serie reventaba según en qué turno le tocara
            correr: la suite pasaba o no pasaba dependiendo del orden.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Los tests jamás tocan el FTP: escribirían basura en el servidor
             compartido de la DGT. Los que ejercitan ese camino se fingen el
             disco con Storage::fake. -->
        <env name="LOTEA_DISCO_ARCHIVOS" value="public" force="true"/>
        <env name="FTP_HOST" value="" force="true"/>
        <env name="FTP_USERNAME" value="" force="true"/>
        <env name="FTP_PASSWORD" value="" force="true"/>

        <!-- Y lo mismo con R2. Sin esto los tests hablaban con los cubos de
             verdad: leían el .env de quien los corre y podían escribir en el
             almacenamiento de producción. Vaciar las credenciales no basta,
             porque el reparto entre cubos lo deciden las dos primeras. -->
        <env name="LOTEA_DISCO_PUBLICO" value="" force="true"/>
        <env name="LOTEA_DISCO_PRIVADO" value="" force="true"/>
        <env name="R2_URL_PUBLICA" value="" force="true"/>
        <env name="R2_ACCESS_KEY_ID" value="" force="true"/>
        <env name="R2_SECRET_ACCESS_KEY" value="" force="true"/>
        <env name="R2_ENDPOINT" value="" force="true"/>
        <env name="R2_BUCKET_PUBLICO" value="" force="true"/>
        <env name="R2_BUCKET_PRIVADO" value="" force="true"/>

        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="lotea_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
